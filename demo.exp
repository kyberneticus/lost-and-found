#!/usr/bin/expect -f

proc wait {ms} {
  set ::tick 0
  after $ms {set ::tick 1}
  vwait ::tick
}

proc hold {secs} {
  wait [expr {int($secs * 1000)}]
}

proc s {text {pause 0.8}} {
  foreach c [split $text ""] {
    send -- $c
    wait [expr {int(45 + rand() * 85)}]
  }
  wait 200
  send -- "\r"
  hold $pause
}

proc submitBlockedClaim {} {
  s 2
  s ""
  s 0
  s ""
  s 2
  s "detail salah"
  s ""
}

set project [file normalize [file dirname [info script]]]
set binary "$project/lostfound"
foreach variable {DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD} {
  if {![info exists env($variable)]} {
    puts stderr "Atur $variable sebelum menjalankan demo."
    exit 1
  }
}
if {![file executable $binary]} {
  puts "Membangun lostfound..."
  set buildCommand [list g++ -std=c++11 -Wall -Wextra "$project/src/main.cpp"]
  foreach flag [split [exec mariadb_config --cflags --libs]] {
    lappend buildCommand $flag
  }
  lappend buildCommand -o $binary
  if {[catch {eval exec $buildCommand} message]} {
    puts stderr $message
    exit 1
  }
}

# shortcut: assumes a fresh database with only seeded demo data; use a temporary demo database for repeatable runs.
set workspace "/tmp/lostfound-demo-[pid]"
file delete -force $workspace
file mkdir $workspace
spawn sh -c "cd '$workspace' && exec '$binary'"
log_user 1
hold 2

# Register a student through the guided major selector.
s 1
s 240001
s "Demo Mahasiswa"
s 1
s "demo@example.com"
s 08123456789
s demo123
s ""

# Deposit a found item, including one failed PIN attempt.
s 2
s 240001
s demo123
s 1
s "Kunci Demo"
s 5
s "Laboratorium Komputer"
s [clock format [clock seconds] -format "%Y-%m-%d"]
s "kunci-demo.jpg"
s "Kunci logam dengan beberapa anak kunci"
s "Gantungan merah"
expect -re {Kode titip: ([0-9]+)} {
  set depositCode $expect_out(1,string)
}
hold 1
s 000000
s $depositCode
s 1
s ""
s 4

# Arya claims and picks up the new item, including one failed PIN attempt.
s 2
s Arya
s Arya123
s 2
s ""
s 0
s ""
s 3
s "Gantungan merah"
expect -re {Kode ambil berlaku 24 jam: ([0-9]+)} {
  set pickupCode $expect_out(1,string)
}
hold 1
s 000000
s $pickupCode
s 1
s ""
s 3
s ""
s 4

# Create a locker anomaly so the admin can mark it defective.
s 2
s 240001
s demo123
s 1
s "Loker Rusak Demo"
s 5
s "Laboratorium Komputer"
s [clock format [clock seconds] -format "%Y-%m-%d"]
s "loker-rusak-demo.jpg"
s ""
s "Stiker biru"
expect -re {Kode titip: ([0-9]+)} {
  set anomalyCode $expect_out(1,string)
}
hold 1
s $anomalyCode
s 3
s ""
s 4

# Block Azhri's claim for Arya's demo wallet after three wrong secret details.
s 2
s Azhri
s Azhri123
submitBlockedClaim
submitBlockedClaim
submitBlockedClaim
s 4

# Admin approves the blocked claim, marks the anomalous locker defective,
# then shows the READY, FULL, and DEFECTIVE locker states.
s 2
s admin
s admin123
s 3
s 1
s 1
s ""
s 2
s 4
s 2
s ""
s 4
s ""
s 5
s 3
expect eof
