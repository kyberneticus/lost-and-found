#!/usr/bin/expect -f
source [file join [file dirname [info script]] lib.exp]

prepareTest
startApp

set suffix [pid]
set lockedNim "71$suffix"
set activeNim "70$suffix"
set password "test123"
registerStudent $lockedNim "Test Kunci $suffix" 1 "locked-$suffix@example.test" "081$suffix" $password

# Three failures lock the account; the correct password cannot bypass the lock.
for {set attempt 1} {$attempt <= 3} {incr attempt} {
  sendLine 2
  sendLine $lockedNim
  sendLine "salah123"
  if {$attempt < 3} {
    expectText {Password salah\.}
  } else {
    expectText {Akun terkunci selama 15 menit karena terlalu banyak percobaan gagal\.}
  }
  sendLine ""
}
sendLine 2
sendLine $lockedNim
sendLine $password
expectText {Akun terkunci selama 15 menit karena terlalu banyak percobaan gagal\.}
sendLine ""

# A different registered account can still log in and log out.
registerStudent $activeNim "Test Autentikasi $suffix" 1 "auth-$suffix@example.test" "080$suffix" $password
loginStudent $activeNim $password
logoutStudent
exitApp
